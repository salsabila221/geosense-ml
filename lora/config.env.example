# =====================================================================
# GeoSense LoRa radio configuration (single source of truth)
# Copy to: /opt/geosense/geosense-processing/lora/config.env
# Edit LORA_PORT after checking: ls -l /dev/serial/by-id/
#
# All nodes and the Jetson receiver must use the same radio settings:
# channel 18 (0x12), 9600 8N1, air rate 2.4k, transparent mode.
# E15-USB-T2 jumpers: M0 & M1 installed, RX/TX jumpers removed.
# These hardware values are documented here; the E220 module/firmware is
# configured separately. The Python code only uses port/baud/ACK/log.
# =====================================================================

# Serial path. Use the stable by-id path on Jetson, not /dev/ttyUSB0.
LORA_PORT=/dev/serial/by-id/CHANGE-ME

# UART baud: 9600 for direct EBYTE/E15-USB-T2; 115200 for ESP32 bridge.
LORA_BAUD=9600

# 0 = lora_receiver.py sends ACK (direct radio).
# 1 = no ACK from Jetson (ESP32 bridge already ACKs).
LORA_NO_ACK=0

# Binary event log (production receiver), rotated by logrotate.
LORA_EVENT_LOG=/var/log/geosense/lora_events.jsonl

# Optional text/CSV diagnostic log used by lora/lora_read.py.
# Leave empty to disable file logging.
LORA_TEXT_LOG=/var/log/geosense/lora_text.log

# ---- Hardware documentation / validation ----
LORA_CHANNEL=18
LORA_AIR_RATE=2.4k
LORA_MODE=transparent
LORA_M0=1
LORA_M1=1
LORA_RX_TX_JUMPER=removed
